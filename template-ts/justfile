# Task runner. `just --list` shows everything; `just --dump --dump-format json`
# gives a machine-readable manifest of recipes, parameters and dependencies.
#
# The contract with agents is: ONE command to know whether the work is done.
# That command is `just verify`. Everything else exists to make `verify` fast
# enough to run often.
#
# Measured on an M-series laptop, warm: verify ~6s. Timings in the comments
# below are from `/usr/bin/time -p` on that machine; treat them as ratios.

set shell := ["bash", "-uc"]

pnpm := "pnpm exec"

# Show available recipes.
default:
    @just --list

# THE gate. If this is green, the change is done. If it is red, it is not.
#
# Warm: ~6 seconds. Cold (no node_modules/, no browser): a few minutes,
# dominated by the ~100MB Chromium download — run `just warm` once after
# cloning and it stays fast afterwards.
#
# Note `fmt`, not `fmt-check`. Formatting is mechanical and auto-fixable, so a
# stray blank line should never be able to mask whether the real work is done.
# Measured: in an eval trial the agent implemented the feature correctly, both
# held-out tests passed, and `verify` still went red purely on formatting in its
# own new test file. That is a wasted turn and a misleading signal. CI still
# runs `fmt-check` so unformatted code cannot land.
verify: fmt lint test-sim test-render
    @echo "✅ verify passed"

# Do the expensive cold setup once, up front, so `verify` stays fast.
#
# The last line is not redundant. Measured on this repo: the steady-state render
# suite is ~1.5s, but the FIRST run after the ~130MB Chromium binary has fallen
# out of the OS page cache took 15-21s. Paying that here, once, is much better
# than paying it inside the run where you are trying to read a test result. It
# also fails loudly and early if the browser cannot start at all.
warm:
    pnpm install --frozen-lockfile
    {{pnpm}} playwright install chromium
    {{pnpm}} vitest run --project render -t "renders a non-empty frame"

# THE FASTEST USEFUL CHECK, ~1.5s. Run this after every edit.
#
# Types (both projects) plus every simulation test: determinism, replay hash
# chains, playability, f32, and the sim/view boundary. It will not catch a
# rendering regression — nothing but `just test-render` can — but it catches the
# large majority of mistakes, and it is fast enough to run without thinking.
fast: check test-sim

# Types only, ~1.8s. Both projects, because `tsconfig.sim.json` is where the
# hexagonal boundary is a compiler error rather than a convention: it checks
# `src/sim` with no DOM lib and no node types, so a `document` or a `process` in
# the simulation fails to compile.
check:
    {{pnpm}} tsc --noEmit
    {{pnpm}} tsc --noEmit -p tsconfig.sim.json

fmt:
    {{pnpm}} prettier --write --log-level warn .

fmt-check:
    {{pnpm}} prettier --check .

# `tsc --noEmit` is part of lint on purpose: a type error is a lint failure, and
# eslint's type-aware rules are only as good as the types they read.
#
# `--cache` takes eslint from 2.2s to 0.6s on an unchanged tree. It is safe in
# the gate: eslint hashes the resolved config into the cache key, so editing
# eslint.config.js invalidates every entry (verified, not assumed).
lint: check
    {{pnpm}} eslint . --cache

# Simulation tests: pure logic, determinism, replay, pipeline order, boundary.
# These are the ones to run constantly — no browser needed, ~0.3s.
test-sim:
    {{pnpm}} vitest run --project sim

# Re-run the simulation tests on every save. The tightest loop there is.
watch:
    {{pnpm}} vitest --project sim

# Rendering tests: real GL, real pixels, no window. ~1.2s warm.
# One browser and one page are shared across the whole file (see
# src/view/harness.ts); each capture still gets a fresh WebGL context, because a
# tab only allows ~16 live ones.
# Forced single-threaded by vitest.config.ts — concurrent WebGL contexts in one
# process contend and produce flaky empty frames.
#
# On failure, PNGs land in tests/render/artifacts/ and their absolute paths are
# printed in the error, along with a numeric description of what differs and
# where. You should not need to open an image to know what broke.
test-render:
    {{pnpm}} vitest run --project render

test:
    {{pnpm}} vitest run

# Regenerate golden images. LOOK AT THE RESULTING PNGs before committing them —
# blessing without looking turns the golden test into a rubber stamp.
bless:
    BLESS=1 {{pnpm}} vitest run --project render -t "matches the golden frame"
    @echo "⚠️  Now open tests/render/golden/*.png and confirm they look right."

# Run the game for real, in a browser, at http://localhost:5173.
# The `tail -f /dev/null |` is not decoration: esbuild's dev server shuts itself
# down when stdin closes, which is exactly what happens when a tool runs this
# non-interactively.
run port="5173":
    tail -f /dev/null | {{pnpm}} esbuild src/view/main.ts --bundle --outfile=public/main.js --servedir=public --serve={{port}}

# Cross-platform determinism check: the same replay must hash identically
# everywhere. Run this on every target you ship to.
test-determinism:
    {{pnpm}} vitest run --project sim tests/sim/determinism.test.ts

# Regenerate docs/three-api.md from the INSTALLED @types/three. Run this after
# any three upgrade; a hand-maintained API note is stale the day it is written.
api-notes:
    node scripts/extract-three-api.mjs > docs/three-api.md
    @echo "wrote docs/three-api.md"

# Coverage report for the simulation module.
coverage:
    {{pnpm}} vitest run --project sim --coverage
    @echo "report: coverage/index.html"

# CI entrypoint: same checks, machine-readable output, no fail-fast.
ci:
    {{pnpm}} prettier --check .
    {{pnpm}} tsc --noEmit
    {{pnpm}} tsc --noEmit -p tsconfig.sim.json
    {{pnpm}} eslint .
    {{pnpm}} vitest run --reporter=junit --outputFile=test-results.xml
