  "artifact_src": "import json\nimport os\nimport sys\n\n\ndef main():\n    if len(sys.argv) != 2:\n        print(\"Usage: probe.py <directory>\", file=sys.stderr)\n        sys.exit(1)\n\n    target_dir = sys.argv[1]\n\n    if not os.path.isdir(target_dir):\n        print(f\"Error: directory not found: {target_dir}\", file=sys.stderr)\n        sys.exit(1)\n\n    values = []\n    for name in os.listdir(target_dir):\n        if not name.endswith(\".json\"):\n            continue\n        path = os.path.join(target_dir, name)\n        if not os.path.isfile(path):\n            continue\n        with open(path, \"r\") as f:\n            data = json.load(f)\n        if isinstance(data, dict) and \"cost_usd\" in data:\n            values.append(data[\"cost_usd\"])\n\n    total = sum(values)\n    mean = total / len(values) if values else 0\n\n    with open(\"summary.json\", \"w\") as f:\n        json.dump({\"total\": total, \"mean\": mean}, f)\n\n\nif __name__ == \"__main__\":\n    main()\n",
