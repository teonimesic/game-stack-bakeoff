  "artifact_src": "import json\nimport sys\nfrom pathlib import Path\nfrom typing import Optional\n\n\ndef extract_cost(file_path: Path) -> Optional[float]:\n    with open(file_path, \"r\") as f:\n        data = json.load(f)\n    if isinstance(data, dict) and \"cost_usd\" in data:\n        return data[\"cost_usd\"]\n    return None\n\n\ndef main() -> None:\n    directory = Path(sys.argv[1])\n\n    files_read = []\n    costs = []\n\n    for entry in sorted(directory.iterdir()):\n        if entry.is_file() and entry.suffix == \".json\":\n            files_read.append(str(entry))\n            cost = extract_cost(entry)\n            if cost is not None:\n                costs.append(cost)\n\n    total = sum(costs)\n    mean = total / len(costs) if costs else 0\n\n    summary = {\n        \"total\": total,\n        \"mean\": mean,\n        \"files_read\": files_read,\n    }\n\n    with open(\"summary.json\", \"w\") as f:\n        json.dump(summary, f)\n\n\nif __name__ == \"__main__\":\n    main()\n",
