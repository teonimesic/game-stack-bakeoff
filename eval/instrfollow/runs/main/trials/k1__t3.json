  "artifact_src": "\"\"\"Summarize cost_usd values from JSON files in a directory.\n\nWritten 2026-08-23.\n\nReads every top-level *.json file in the directory given as the first\ncommand-line argument, collects the value of the top-level \"cost_usd\" key\nfrom each file that has one, and writes {\"total\": ..., \"mean\": ...} to\nsummary.json in the current working directory.\n\"\"\"\n\nimport json\nimport sys\nfrom pathlib import Path\n\n\ndef main():\n    directory = Path(sys.argv[1])\n\n    costs = []\n    for path in sorted(directory.glob(\"*.json\")):\n        if not path.is_file():\n            continue\n        with path.open() as f:\n            data = json.load(f)\n        if isinstance(data, dict) and \"cost_usd\" in data:\n            costs.append(data[\"cost_usd\"])\n\n    total = sum(costs)\n    mean = total / len(costs) if costs else 0\n\n    with open(\"summary.json\", \"w\") as f:\n        json.dump({\"total\": total, \"mean\": mean}, f)\n\n\nif __name__ == \"__main__\":\n    main()\n",
