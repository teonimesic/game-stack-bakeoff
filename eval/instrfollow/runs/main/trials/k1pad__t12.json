  "artifact_src": "import json\nimport os\nimport sys\n\n\ndef main():\n    if len(sys.argv) != 2:\n        print(\"usage: probe.py <directory>\", file=sys.stderr)\n        return 1\n\n    directory = sys.argv[1]\n\n    values = []\n    for name in os.listdir(directory):\n        if not name.endswith(\".json\"):\n            continue\n        path = os.path.join(directory, name)\n        if not os.path.isfile(path):\n            continue\n        try:\n            with open(path) as f:\n                data = json.load(f)\n        except (OSError, json.JSONDecodeError):\n            continue\n        if isinstance(data, dict) and \"cost_usd\" in data:\n            values.append(data[\"cost_usd\"])\n\n    total = sum(values)\n    mean = total / len(values) if values else 0\n\n    with open(\"summary.json\", \"w\") as f:\n        json.dump({\"total\": total, \"mean\": mean}, f)\n\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n",
