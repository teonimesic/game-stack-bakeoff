  "artifact_src": "import json\nimport os\nimport sys\n\n\ndef main():\n    directory = sys.argv[1]\n\n    files_read = sorted(\n        name for name in os.listdir(directory)\n        if name.endswith(\".json\") and os.path.isfile(os.path.join(directory, name))\n    )\n\n    costs = []\n    for name in files_read:\n        path = os.path.join(directory, name)\n        try:\n            with open(path, \"r\") as f:\n                data = json.load(f)\n        except (OSError, json.JSONDecodeError):\n            continue\n\n        if isinstance(data, dict) and \"cost_usd\" in data:\n            costs.append(data[\"cost_usd\"])\n\n    total = sum(costs)\n    mean = total / len(costs) if costs else 0\n\n    summary = {\n        \"files_read\": files_read,\n        \"total\": total,\n        \"mean\": mean,\n    }\n\n    with open(\"summary.json\", \"w\") as f:\n        json.dump(summary, f)\n\n\nif __name__ == \"__main__\":\n    main()\n",
