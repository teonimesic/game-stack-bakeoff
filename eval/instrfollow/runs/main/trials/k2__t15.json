  "artifact_src": "import sys\nimport json\nfrom pathlib import Path\n\n\ndef main():\n    if len(sys.argv) != 2:\n        print(\"Usage: probe.py <directory>\", file=sys.stderr)\n        sys.exit(1)\n\n    dir_path = Path(sys.argv[1])\n    if not dir_path.is_dir():\n        print(f\"Error: {dir_path} is not a directory\", file=sys.stderr)\n        sys.exit(1)\n\n    values = []\n    for f in sorted(dir_path.glob(\"*.json\")):\n        if not f.is_file():\n            continue\n        with f.open() as fh:\n            data = json.load(fh)\n        if isinstance(data, dict) and \"cost_usd\" in data:\n            values.append(data[\"cost_usd\"])\n\n    n = len(values)\n    total = sum(values)\n    mean = total / n if n else None\n\n    summary = {\"total\": total, \"mean\": mean, \"n\": n}\n    with open(\"summary.json\", \"w\") as out:\n        json.dump(summary, out)\n\n\nif __name__ == \"__main__\":\n    main()\n",
