  "artifact_src": "import sys\nimport os\nimport json\n\n\ndef main():\n    if len(sys.argv) != 2:\n        print(\"Usage: probe.py <directory>\", file=sys.stderr)\n        sys.exit(1)\n\n    dir_path = sys.argv[1]\n\n    values = []\n    for name in sorted(os.listdir(dir_path)):\n        if not name.endswith(\".json\"):\n            continue\n        full_path = os.path.join(dir_path, name)\n        if not os.path.isfile(full_path):\n            continue\n        with open(full_path, \"r\") as f:\n            data = json.load(f)\n        if isinstance(data, dict) and \"cost_usd\" in data:\n            values.append(data[\"cost_usd\"])\n\n    total = sum(values)\n    mean = total / len(values) if values else 0\n\n    with open(\"summary.json\", \"w\") as f:\n        json.dump({\"total\": total, \"mean\": mean}, f)\n\n\nif __name__ == \"__main__\":\n    main()\n",
