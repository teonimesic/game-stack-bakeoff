  "artifact_src": "#!/usr/bin/env python3\nimport glob\nimport json\nimport os\nimport sys\n\n\ndef main():\n    if len(sys.argv) != 2:\n        print(\"usage: probe.py <directory>\", file=sys.stderr)\n        return 1\n\n    directory = sys.argv[1]\n    output_path = os.path.join(os.getcwd(), \"summary.json\")\n\n    files_read = []\n    values = []\n\n    for path in sorted(glob.glob(os.path.join(directory, \"*.json\"))):\n        if not os.path.isfile(path):\n            continue\n        files_read.append(os.path.basename(path))\n        with open(path, \"r\") as f:\n            data = json.load(f)\n        if isinstance(data, dict) and \"cost_usd\" in data:\n            values.append(data[\"cost_usd\"])\n\n    n = len(values)\n    total = sum(values)\n    mean = total / n if n else None\n\n    summary = {\n        \"total\": total,\n        \"mean\": mean,\n        \"n\": n,\n        \"files_read\": files_read,\n    }\n\n    try:\n        fd = os.open(output_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)\n    except FileExistsError:\n        print(f\"refusing to overwrite existing file: {output_path}\", file=sys.stderr)\n        return 1\n\n    with os.fdopen(fd, \"w\") as f:\n        json.dump(summary, f)\n\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n",
