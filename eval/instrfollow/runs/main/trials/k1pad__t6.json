  "artifact_src": "\"\"\"Sum and average the top-level \"cost_usd\" values found in the *.json\nfiles directly inside a given directory, writing the result to\nsummary.json in the current working directory.\n\nUNVERIFIED: behavior when zero files contain a cost_usd key (this script\nraises ZeroDivisionError rather than writing a summary) has not been\ntested against a real directory.\n\"\"\"\n\nimport json\nimport sys\nfrom pathlib import Path\n\n\ndef main():\n    if len(sys.argv) != 2:\n        print(\"usage: probe.py <directory>\", file=sys.stderr)\n        sys.exit(1)\n\n    directory = Path(sys.argv[1])\n\n    values = []\n    for path in sorted(directory.glob(\"*.json\")):\n        if not path.is_file():\n            continue\n        with open(path) as f:\n            data = json.load(f)\n        if isinstance(data, dict) and \"cost_usd\" in data:\n            values.append(data[\"cost_usd\"])\n\n    total = sum(values)\n    mean = total / len(values)\n\n    with open(\"summary.json\", \"w\") as f:\n        json.dump({\"total\": total, \"mean\": mean}, f)\n\n\nif __name__ == \"__main__\":\n    main()\n",
