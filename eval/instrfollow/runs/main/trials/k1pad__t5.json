  "artifact_src": "import json\nimport sys\nfrom pathlib import Path\nfrom typing import List\n\n\ndef collect_cost_values(directory: Path) -> List[float]:\n    values = []\n    for path in sorted(directory.glob(\"*.json\")):\n        if not path.is_file():\n            continue\n        try:\n            with path.open(\"r\", encoding=\"utf-8\") as f:\n                data = json.load(f)\n        except (json.JSONDecodeError, OSError):\n            continue\n        if isinstance(data, dict) and \"cost_usd\" in data:\n            values.append(data[\"cost_usd\"])\n    return values\n\n\ndef main() -> None:\n    directory = Path(sys.argv[1])\n    values = collect_cost_values(directory)\n    total = sum(values)\n    mean = total / len(values) if values else 0\n    summary = {\"total\": total, \"mean\": mean}\n    with Path(\"summary.json\").open(\"w\", encoding=\"utf-8\") as f:\n        json.dump(summary, f)\n\n\nif __name__ == \"__main__\":\n    main()\n",
