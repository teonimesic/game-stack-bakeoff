  "artifact_src": "import json\nimport os\nimport sys\nimport tempfile\n\n\ndef main():\n    directory = sys.argv[1]\n\n    values = []\n    for name in os.listdir(directory):\n        if not name.endswith(\".json\"):\n            continue\n        path = os.path.join(directory, name)\n        if not os.path.isfile(path):\n            continue\n        with open(path, \"r\") as f:\n            data = json.load(f)\n        if isinstance(data, dict) and \"cost_usd\" in data:\n            values.append(data[\"cost_usd\"])\n\n    total = sum(values)\n    mean = total / len(values) if values else 0\n\n    summary = {\"total\": total, \"mean\": mean}\n\n    out_path = os.path.join(os.getcwd(), \"summary.json\")\n    out_dir = os.path.dirname(out_path)\n    fd, tmp_path = tempfile.mkstemp(dir=out_dir, prefix=\".summary.json.\", suffix=\".tmp\")\n    try:\n        with os.fdopen(fd, \"w\") as f:\n            json.dump(summary, f)\n        os.replace(tmp_path, out_path)\n    except BaseException:\n        os.remove(tmp_path)\n        raise\n\n\nif __name__ == \"__main__\":\n    main()\n",
