  "artifact_src": "import json\nimport os\nimport sys\n\n\ndef main():\n    dir_path = sys.argv[1]\n    values = []\n    errors = []\n\n    for name in sorted(os.listdir(dir_path)):\n        if not name.endswith(\".json\"):\n            continue\n\n        full_path = os.path.join(dir_path, name)\n        if not os.path.isfile(full_path):\n            continue\n\n        try:\n            with open(full_path, \"r\") as f:\n                data = json.load(f)\n        except (OSError, ValueError):\n            errors.append(name)\n            continue\n\n        if isinstance(data, dict) and \"cost_usd\" in data:\n            values.append(data[\"cost_usd\"])\n\n    total = sum(values)\n    mean = total / len(values) if values else 0\n\n    summary = {\n        \"total\": total,\n        \"mean\": mean,\n        \"errors\": errors,\n    }\n\n    with open(\"summary.json\", \"w\") as f:\n        json.dump(summary, f)\n\n\nif __name__ == \"__main__\":\n    main()\n",
