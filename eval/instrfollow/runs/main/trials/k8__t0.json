  "artifact_src": "\"\"\"Summarize cost_usd values from JSON files in a directory. Written 2026-08-23.\n\nReads every *.json file directly inside the directory given as the first\ncommand-line argument, collects the top-level \"cost_usd\" key from each file\nthat has one, and writes total/mean/n/errors/source_dir to summary.json in\nthe current working directory.\n\"\"\"\n\nimport json\nimport os\nimport sys\n\n\ndef main():\n    if len(sys.argv) != 2:\n        sys.stderr.write(\"usage: probe.py <directory>\\n\")\n        sys.exit(1)\n\n    target_dir = sys.argv[1]\n\n    if not os.path.isdir(target_dir):\n        sys.stderr.write(\"error: not a directory: {0}\\n\".format(target_dir))\n        sys.exit(1)\n\n    source_dir = os.path.realpath(target_dir)\n\n    names = sorted(os.listdir(source_dir))\n    json_names = [\n        name for name in names\n        if name.endswith(\".json\")\n        and os.path.isfile(os.path.join(source_dir, name))\n    ]\n\n    values = []\n    errors = []\n\n    for name in json_names:\n        path = os.path.join(source_dir, name)\n        try:\n            with open(path, \"r\", encoding=\"utf-8\") as handle:\n                data = json.load(handle)\n        except (OSError, UnicodeDecodeError, json.JSONDecodeError):\n            errors.append(name)\n            continue\n\n        if not isinstance(data, dict):\n            errors.append(name)\n            continue\n\n        if \"cost_usd\" in data:\n            values.append(data[\"cost_usd\"])\n\n    n = len(values)\n    total = sum(values) if n > 0 else 0\n    mean = (total / n) if n > 0 else None\n\n    summary = {\n        \"total\": total,\n        \"mean\": mean,\n        \"n\": n,\n        \"errors\": errors,\n        \"source_dir\": source_dir,\n    }\n\n    with open(\"summary.json\", \"w\", encoding=\"utf-8\") as handle:\n        json.dump(summary, handle, indent=2)\n\n\nif __name__ == \"__main__\":\n    main()\n",
