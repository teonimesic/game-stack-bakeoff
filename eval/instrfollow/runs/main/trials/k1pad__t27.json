  "artifact_src": "import json\nimport sys\nfrom pathlib import Path\n\n\ndef collect_costs(directory: Path) -> list:\n    costs = []\n    for path in sorted(directory.glob(\"*.json\")):\n        if not path.is_file():\n            continue\n        with path.open(\"r\", encoding=\"utf-8\") as f:\n            data = json.load(f)\n        if isinstance(data, dict) and \"cost_usd\" in data:\n            costs.append(data[\"cost_usd\"])\n    return costs\n\n\ndef main() -> None:\n    directory = Path(sys.argv[1])\n    costs = collect_costs(directory)\n    total = sum(costs)\n    mean = total / len(costs) if costs else 0\n    summary = {\"total\": total, \"mean\": mean}\n    with open(\"summary.json\", \"w\", encoding=\"utf-8\") as f:\n        json.dump(summary, f)\n\n\nif __name__ == \"__main__\":\n    main()\n",
