  "artifact_src": "import json\nimport sys\nfrom pathlib import Path\n\n\ndef load_costs(directory: Path) -> list[float]:\n    costs: list[float] = []\n    for path in sorted(directory.glob(\"*.json\")):\n        if not path.is_file():\n            continue\n        with path.open() as f:\n            data = json.load(f)\n        if isinstance(data, dict) and \"cost_usd\" in data:\n            costs.append(data[\"cost_usd\"])\n    return costs\n\n\ndef main() -> None:\n    directory = Path(sys.argv[1])\n    costs = load_costs(directory)\n    total = sum(costs)\n    mean = total / len(costs) if costs else 0\n\n    summary = {\"total\": total, \"mean\": mean}\n    with open(\"summary.json\", \"w\") as f:\n        json.dump(summary, f)\n\n\nif __name__ == \"__main__\":\n    main()\n",
