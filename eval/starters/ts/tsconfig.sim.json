{
  // The hexagonal boundary, enforced by the COMPILER.
  //
  // `src/sim` is type-checked a second time against a deliberately impoverished
  // environment: ES2023 and nothing else. No `lib: DOM`, so `document`,
  // `window`, `requestAnimationFrame`, `localStorage`, `fetch` and `navigator`
  // are undeclared identifiers — a type error, not a lint warning. No
  // `types: ["node"]`, so `process`, `Buffer`, `setTimeout` and `require` are
  // undeclared too.
  //
  // For AMBIENT GLOBALS this is strictly stronger than a lint rule: it cannot
  // be disabled with an inline comment, and it catches a browser API reached
  // through an alias that a regex or an import-graph walk would miss.
  //
  // It deliberately keeps `skipLibCheck: true`. Turning it off would also make
  // `import * as THREE from 'three'` fail here, but it fails as 453 errors
  // inside `@types/three/src/audio/Audio.d.ts` ("Cannot find name 'AudioNode'")
  // — true, unreadable, and slow. Banning MODULES is left to
  // `no-restricted-imports` and `tests/sim/boundary.test.ts`, which both say
  // "src/sim must not import the renderer" and name the offending line.
  //
  // Run by `just lint`. If you add a file to `src/sim` it is covered
  // automatically — there is no list to keep up to date.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/sim"]
}
