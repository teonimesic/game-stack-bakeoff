# Godot's import/resource cache. Rebuilt automatically; never commit it.
.godot/

# Generated by the import step, one per imported asset.
*.import

# Failure artifacts written by the golden-image test.
tests/golden/*.actual.png
tests/golden/*.expected.png
tests/golden/*.diff.png

# `just warm` creates this; it holds gdformat and gdlint.
.venv/
