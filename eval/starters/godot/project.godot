; Godot project configuration.
;
; Three blocks here are load-bearing and must not be "tidied up":
;   [debug]     static typing enforcement    (see AGENTS.md)
;   [physics]   the fixed tick rate          (must equal Sim.TICK_HZ)
;   [rendering] the 2D colour pipeline the render tests assert byte values on
;
; Everything else is ordinary window setup.

config_version=5

[application]

config/name="starter-godot"
config/description="Deterministic, verifiable game starter. sim/ is pure logic; view/ only draws."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=640
window/size/viewport_height=400
; The render tests capture the root viewport at exactly this size. HiDPI scaling
; would make the captured image 2x on a Retina display and every pixel
; coordinate in tests/render_test.gd wrong.
window/dpi/allow_hidpi=false

[physics]

; `view/main.gd` steps the simulation from `_physics_process`, so this number IS
; `Sim.TICK_HZ`. `tests/boundary_test.gd` fails if the two ever drift apart.
common/physics_ticks_per_second=64
common/max_physics_steps_per_frame=8

[debug]

; ---------------------------------------------------------------------------
; STATIC TYPING ENFORCEMENT — the single highest-value setting in this file.
;
; GDScript is gradually typed and ships with all of this OFF or at warn level,
; which means `var x = foo()` compiles happily, every call on `x` is resolved by
; name at runtime, and a typo becomes a crash forty seconds into a playtest
; instead of a compile error.
;
; 0 = ignore, 1 = warn, 2 = ERROR. At level 2 the script FAILS TO COMPILE, so
; `just check` and every test run catch it. Do not lower these to get past a
; warning; add the type. If a genuinely dynamic call is unavoidable, suppress it
; at the single line with @warning_ignore("unsafe_call_argument") and say why —
; there is exactly one example, in tests/test_runner.gd.
; ---------------------------------------------------------------------------
gdscript/warnings/enable=true
gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_declaration=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/narrowing_conversion=2
gdscript/warnings/incompatible_ternary=2
gdscript/warnings/return_value_discarded=0
gdscript/warnings/unused_parameter=1
gdscript/warnings/integer_division=1

[rendering]

; The render tests assert on exact byte values (see View.to_u8). Anything that
; introduces a tonemapper or an sRGB round trip between draw_rect and the
; framebuffer changes those bytes without changing the geometry, and every pixel
; assertion in tests/render_test.gd starts lying.
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.09, 1)
anti_aliasing/quality/msaa_2d=0
textures/canvas_textures/default_texture_filter=0

[autoload]

NoRaise="*res://tools/no_raise.gd"
