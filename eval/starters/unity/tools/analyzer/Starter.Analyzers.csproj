<Project Sdk="Microsoft.NET.Sdk">

  <!-- Source for Assets/Analyzers/Starter.Analyzers.dll.

       The DLL is VENDORED (committed) so the template needs no .NET SDK and no
       network to enforce its rules. This project only exists so the rules are
       readable and editable; `just analyzers` rebuilds and re-vendors it.

       Microsoft.CodeAnalysis.CSharp is pinned to 4.3.1 because that is the
       Roslyn that Unity 6000.0.45f1 ships in
       Unity.app/Contents/DotNetSdkRoslyn. An analyzer built against a NEWER
       Roslyn loads but silently disables itself (csc warning CS8032). -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Starter.Analyzers</AssemblyName>
    <RootNamespace>Starter.Analyzers</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" />
  </ItemGroup>

</Project>
