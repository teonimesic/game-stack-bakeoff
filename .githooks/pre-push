#!/bin/sh
# Runs the pre-push tier of run-gates.sh: the pre-commit set plus the documentation sweep.
# WHICH gates that is, the bypass and the worktree caveat: .github/workflows/README.md,
# whose hook table is asserted against this script by `ci_minutes.py --selftest`. No
# duration is written anywhere -- time it with `time .githooks/run-gates.sh pre-push`.
exec "$(git rev-parse --show-toplevel)/.githooks/run-gates.sh" pre-push
