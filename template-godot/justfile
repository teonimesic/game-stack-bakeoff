# Task runner. `just --list` shows everything; `just --dump --dump-format json`
# gives a machine-readable manifest of recipes, parameters and dependencies.
#
# The contract with agents is: ONE command to know whether the work is done.
# That command is `just verify`. Everything else exists to make `verify` fast
# enough to run often.

set shell := ["bash", "-uc"]

godot := env_var_or_default("GODOT", "godot")
gdformat := "./.venv/bin/gdformat"
gdlint := "./.venv/bin/gdlint"
sources := "sim view tests tools"

# Show available recipes.
default:
    @just --list

# THE gate. If this is green, the change is done. If it is red, it is not.
#
# Warm: ~4 seconds total (check ~0.5s, sim ~1s, render ~1s, the rest is Godot
# start-up). There is no compile step in this stack, so there is no cold-build
# cliff — `just warm` only exists to create the Python venv that holds gdformat
# and gdlint.
#
# Note `fmt`, not `fmt-check`. Formatting is mechanical and auto-fixable, so a
# stray blank line should never be able to mask whether the real work is done.
# Measured in an earlier eval trial on another stack: the agent implemented the
# feature correctly, both held-out tests passed, and `verify` went red purely on
# formatting in its own new test file. That is a wasted turn and a misleading
# signal. CI still runs `fmt-check`, so unformatted code cannot land.
verify: fmt lint check test-sim test-render
    @echo "✅ verify passed"

# One-time setup: a venv for gdformat/gdlint. ~15s, and only needed once.
# Everything else in this file works without it.
warm:
    #!/usr/bin/env bash
    set -uo pipefail
    # Tries several interpreters because a broken `python3` on PATH is common
    # (Homebrew upgrades, pyenv shims). gdtoolkit works on 3.9+.
    for py in python3 python3.13 python3.12 python3.11 /usr/bin/python3; do
        command -v "$py" >/dev/null 2>&1 || continue
        rm -rf .venv
        "$py" -m venv .venv >/dev/null 2>&1 && [ -x ./.venv/bin/pip ] && break
    done
    if [ ! -x ./.venv/bin/pip ]; then
        echo "could not create a Python venv; fmt and lint will be skipped" >&2
        rm -rf .venv
    else
        ./.venv/bin/pip install --quiet --disable-pip-version-check 'gdtoolkit==4.*'
    fi
    just _sync
    echo "✅ warm: project imported$([ -x ./.venv/bin/gdlint ] && echo ', gdtoolkit installed')"

# Refresh Godot's global class registry. Needed after ADDING a file with a
# `class_name`, otherwise the new name does not resolve and the runner aborts.
# Cheap and idempotent (~3s), and skipped entirely when nothing changed.
_sync:
    @if [ ! -f .godot/global_script_class_cache.cfg ] || \
        [ -n "$(find {{sources}} -name '*.gd' -newer .godot/global_script_class_cache.cfg -print -quit 2>/dev/null)" ]; then \
        echo "→ registering script classes"; \
        {{godot}} --headless --path . --import >/dev/null 2>&1 || true; \
    fi

# The fastest signal in the repo (~0.5s, no display, no tests):
#   * compiles EVERY .gd file, so the static-typing errors in project.godot fire
#     even for a file nothing imports yet
#   * runs the sim/ boundary guard
# Run this constantly while editing.
check: _sync
    @{{godot}} --headless --path . -s res://tools/check.gd

fmt:
    @if [ -x {{gdformat}} ]; then {{gdformat}} {{sources}}; \
     else echo "SKIP fmt: gdtoolkit is not installed — run \`just warm\`"; fi

fmt-check:
    @if [ -x {{gdformat}} ]; then {{gdformat}} --check {{sources}}; \
     else echo "SKIP fmt-check: gdtoolkit is not installed — run \`just warm\`"; exit 1; fi

lint:
    @if [ -x {{gdlint}} ]; then {{gdlint}} {{sources}}; \
     else echo "SKIP lint: gdtoolkit is not installed — run \`just warm\`"; fi

# Simulation tests: pure logic, determinism, replay, the boundary guard.
# Headless, no display, ~1s. These are the ones to run constantly.
#
# `just test-sim --strict` turns a skipped test into a failure. `ci` uses it.
test-sim *args: _sync
    @{{godot}} --headless --path . -s res://tests/run_sim_tests.gd -- {{args}}

# Rendering tests: real GPU, real pixels, REAL WINDOW.
#
# There is deliberately no `--headless` here. Godot's headless display driver
# installs a dummy rendering driver: nothing is drawn and
# `get_viewport().get_texture().get_image()` returns null. A 640x400 window will
# flash on screen for about a second. On a machine with no display (CI, ssh),
# run this under `xvfb-run -a just test-render`.
#
# With no display at all the suite reports SKIP and still exits 0, so a developer
# who cannot fix it is not blocked. `just test-render --strict` makes those skips
# FAILURES; `ci` uses it, because a green pipeline over zero render coverage is
# worse than a red one.
test-render *args: _sync
    @{{godot}} --path . --resolution 640x400 -s res://tests/run_render_tests.gd -- {{args}}

test: test-sim test-render

# Regenerate golden images. LOOK AT THE RESULTING PNGs before committing them —
# blessing without looking turns the golden test into a rubber stamp.
bless: _sync
    @{{godot}} --path . --resolution 640x400 -s res://tests/run_render_tests.gd -- --bless
    @echo "⚠️  Now open tests/golden/*.png and confirm they look right."

# Play it. W/S move the left paddle, Up/Down the right.
run: _sync
    @{{godot}} --path .

# Cross-platform determinism check: the same replay must hash identically
# everywhere. Run this on every target you ship to.
test-determinism: test-sim

# CI entrypoint: same checks, plus two things `verify` deliberately leaves out —
# the format check, and --strict, under which a SKIPPED test is a FAILED test.
# CI must never be able to report green while the render suite skipped itself
# because the runner had no display.
ci: _sync fmt-check lint check (test-sim "--strict") (test-render "--strict")

# Delete generated state. `.godot/` is a cache; it is rebuilt by `_sync`.
clean:
    rm -rf .godot tests/golden/*.actual.png tests/golden/*.expected.png tests/golden/*.diff.png
