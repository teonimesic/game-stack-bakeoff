# gdlint (gdtoolkit 4.x) configuration.
#
# Two departures from the default, both deliberate:
#
#   class-definitions-order  Disabled. gdlint wants every inner class hoisted
#                            above every function. sim/sim.gd is organised in
#                            topic sections (identity, intent, state, schedule,
#                            hashing) with each section's class next to the
#                            functions that use it, which is easier to read and
#                            to extend than one wall of classes.
#
#   class-variable-name      Widened to allow SCREAMING_CASE, so the static
#                            `SIM_PIPELINE` table can be named like the constant
#                            it effectively is.
#
# Everything else is stock. Do NOT add rules to `disable` to get past a lint
# failure; fix the code.
disable:
- class-definitions-order
class-variable-name: (_?[a-z][a-z0-9]*(_[a-z0-9]+)*|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)
max-file-lines: 600
max-public-methods: 25
